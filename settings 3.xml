<settings xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
	<localRepository>C:/EDWork/repository</localRepository>
	<proxies>
		<proxy>
			<active>true</active>
			<id>generic-proxy-http</id>
			<host>generic-proxy.qv.de</host>
			<port>8080</port>
			<protocol>http</protocol>
			<nonProxyHosts>*.qv.de|*.local.ergodirekt.de|localhost|127.0.0.*</nonProxyHosts>
		</proxy>
	</proxies>
	<servers>
		<server>
			<id>subversion.qv.de</id>
			<username>yuverma</username>
			<password></password>
		</server>
		<server>
			<id>cvs.qv.de</id>
			<username>yuverma</username>
			<password></password>
		</server>
		<server>
			<id>hudson.qv.de</id>
			<username>yuverma</username>
			<password></password>
		</server>
		<server>
			<id>https://hudson33.local.ergodirekt.de:443</id>
			<username>yuverma</username>
			<password></password>
		</server>
		<server>
			<id>kqv.central.site</id>
			<username>upload</username>
			<privateKey>C:/EDWork/.ssh/id_rsa</privateKey>
		</server>
		<server>
			<id>kqv.central.release</id>
			<username>test</username>
			<password>Oktober211015</password>
		</server>
		<server>
			<id>kqv.central.snapshots</id>
			<username>test</username>
			<password>Oktober211015</password>
		</server>
	</servers>
	<mirrors>
		<mirror>
			<id>nexus-proxy.qv.de</id>
			<name>KQV Central Maven2 Mirror</name>
			<url>https://nexus-prx.local.ergodirekt.de/content/groups/public</url>
			<mirrorOf>*,!kqv.central.release,!kqv.central.snapshots,!public.repositories,!public.snapshot.repositories,!public.repositories.plugin,!public.snapshot.repositories.plugin</mirrorOf>
		</mirror>
	</mirrors>
	<pluginGroups>
		<pluginGroup>de.ergodirekt.maven.plugins</pluginGroup>
	</pluginGroups>
	<profiles>
		<profile>
			<id>defaults</id>
			<repositories>
				<repository>
					<name>Public Repositories</name>
					<!--url>https://nexus-prx.local.ergodirekt.de/content/groups/public</url-->
					<url>https://nexus-prx.local.ergodirekt.de/repository/public</url>
					<id>public.repositories</id>
					<releases>
						<enabled>true</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</releases>
					<snapshots>
						<enabled>false</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</snapshots>
				</repository>
				<repository>
					<name>Public Snapshot Repositories</name>
					<!--url>https://nexus-prx.local.ergodirekt.de/content/groups/public-snapshots</url-->
					<url>https://nexus-prx.local.ergodirekt.de/repository/public-snapshots</url>
					<id>public.snapshot.repositories</id>
					<releases>
						<enabled>false</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</releases>
					<snapshots>
						<enabled>true</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</snapshots>
				</repository>
			</repositories>
			<pluginRepositories>
				<pluginRepository>
					<name>Public Repositories Plugin</name>
					<url>https://nexus-prx.local.ergodirekt.de/content/groups/public</url>
					<id>public.repositories.plugin</id>
					<releases>
						<enabled>true</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</releases>
					<snapshots>
						<enabled>false</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</snapshots>
				</pluginRepository>
				<pluginRepository>
					<name>Public Snapshot Repositories Plugin</name>
					<url>https://nexus-prx.local.ergodirekt.de/content/groups/public-snapshots</url>
					<id>public.snapshot.repositories.plugin</id>
					<releases>
						<enabled>false</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</releases>
					<snapshots>
						<enabled>true</enabled>
						<checksumPolicy>ignore</checksumPolicy>
					</snapshots>
				</pluginRepository>
			</pluginRepositories>
		</profile>
	</profiles>
	<activeProfiles>
		<activeProfile>defaults</activeProfile>
	</activeProfiles>
</settings>
